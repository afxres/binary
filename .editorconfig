root = true

# Global: LF line endings, UTF-8, one trailing newline, no trailing whitespace, 4 spaces
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces mean a hard line break in markdown, do not trim them
[*.md]
trim_trailing_whitespace = false

# MSBuild and CI files use 2 spaces (csproj/fsproj carry a BOM, props/slnx do not)
[*.{csproj,fsproj}]
charset = utf-8-bom
indent_size = 2

[*.{props,targets,yml,yaml,json,xml,slnx}]
indent_size = 2

[*.cs]
charset = utf-8-bom

# Qualify fields, properties and events with 'this.', never methods
dotnet_style_qualification_for_field = true
dotnet_style_qualification_for_property = true
dotnet_style_qualification_for_event = true
dotnet_style_qualification_for_method = false

# Language keywords instead of framework type names
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true

# 'is null' instead of '== null'
dotnet_style_prefer_is_null_check_over_reference_equality_method = true

# Always 'var'
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true

# Namespace and using directives: file scoped namespace, using inside it, no leading System group
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = inside_namespace:warning
dotnet_sort_system_directives_first = false
dotnet_separate_import_directive_groups = false

# Spell out the conventions already in use
csharp_prefer_simple_using_statement = true:warning
csharp_style_conditional_delegate_call = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_prefer_collection_expression = when_types_loosely_match:warning
csharp_style_prefer_compound_assignment = true:warning
csharp_style_prefer_method_group_conversion = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_throw_expression = true:warning
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_namespace_match_folder = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true:warning
dotnet_style_readonly_field = true:warning

# Conventions explicitly not used
csharp_style_implicit_object_creation_when_type_is_apparent = false:silent
csharp_style_prefer_index_operator = false
csharp_style_prefer_primary_constructors = false:silent
csharp_style_prefer_range_operator = false
dotnet_style_prefer_conditional_expression_over_assignment = false:silent
dotnet_style_prefer_conditional_expression_over_return = false:silent

# Allman braces and spacing
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_labels = one_less_than_current
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

# Naming: const and static readonly fields are PascalCase, private instance fields are camelCase
dotnet_naming_rule.constant_field_should_be_pascal_case.severity = warning
dotnet_naming_rule.constant_field_should_be_pascal_case.symbols = constant_field
dotnet_naming_rule.constant_field_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_field_should_be_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_field_should_be_pascal_case.symbols = static_readonly_field
dotnet_naming_rule.static_readonly_field_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.private_field_should_be_camel_case.severity = warning
dotnet_naming_rule.private_field_should_be_camel_case.symbols = private_field
dotnet_naming_rule.private_field_should_be_camel_case.style = camel_case
dotnet_naming_symbols.constant_field.applicable_kinds = field
dotnet_naming_symbols.constant_field.required_modifiers = const
dotnet_naming_symbols.static_readonly_field.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field.required_modifiers = static, readonly
dotnet_naming_symbols.private_field.applicable_kinds = field
dotnet_naming_symbols.private_field.applicable_accessibilities = private
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

# Diagnostics
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0041.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0058.severity = warning

# This case uses PascalCase names for private instance and private static fields on purpose
[code/Binary.SourceGeneration.NamedObjectTests/PlainObjectTests/MixedMembersTests.cs]
dotnet_naming_rule.private_field_should_be_camel_case.severity = none

[*.fs]
insert_final_newline = true
max_line_length = 160
fsharp_max_record_width = 160
fsharp_max_array_or_list_width = 160
fsharp_max_value_binding_width = 160
fsharp_max_function_binding_width = 80
fsharp_max_if_then_else_short_width = 80
fsharp_max_infix_operator_expression = 160
fsharp_multiline_bracket_style = stroustrup
fsharp_blank_lines_around_nested_multiline_expressions = false
fsharp_newline_before_multiline_computation_expression = false
